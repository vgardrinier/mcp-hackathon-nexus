#!/bin/bash

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  NEXUS CLI - Beautiful terminal interface for your local MCP proxy       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Detect repo directory
REPO_DIR=""
if [ -d "$HOME/.nexus/repo" ]; then
    REPO_DIR="$HOME/.nexus/repo"
elif [ -f "docker-compose.yml" ] && [ -d "apps/mcp" ]; then
    REPO_DIR="$(pwd)"
else
    echo -e "${RED}✗${NC} Nexus not found. Please run the install script first."
    exit 1
fi

LOG_FILE="$HOME/.config/nexus/logs/activity.jsonl"

# ═══════════════════════════════════════════════════════════════════════════
# HELPER FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════

# Check if Docker is running
check_docker() {
    if ! docker ps &> /dev/null 2>&1; then
        echo -e "${RED}✗${NC} Docker is not running. Please start Docker Desktop."
        exit 1
    fi
}

# Format timestamp to be more readable
format_timestamp() {
    local ts="$1"
    if date -j &>/dev/null 2>&1; then
        date -j -f "%Y-%m-%dT%H:%M:%S" "${ts:0:19}" "+%H:%M:%S" 2>/dev/null || echo "${ts:11:8}"
    else
        date -d "$ts" "+%H:%M:%S" 2>/dev/null || echo "${ts:11:8}"
    fi
}

# Get emoji for action
get_action_emoji() {
    case "$1" in
        search|find|query) echo "🔍" ;;
        list|get|read|fetch) echo "📖" ;;
        create|add) echo "✍️ " ;;
        update|edit|modify) echo "✏️ " ;;
        delete|remove) echo "🗑️ " ;;
        scrape|crawl) echo "🕷️ " ;;
        map) echo "🗺️ " ;;
        extract) echo "🔬" ;;
        check) echo "✅" ;;
        batch) echo "📦" ;;
        *) echo "🔧" ;;
    esac
}

# Get security badge
get_security_badge() {
    local status="$1"
    local trust="$2"
    
    case "$status" in
        blocked)  echo "${RED}🛡️ BLOCKED${NC}" ;;
        monitored) echo "${YELLOW}⚠️  WATCHED${NC}" ;;
        safe)
            if [ "$trust" = "untrusted" ]; then
                echo "${YELLOW}👁️  EXTERNAL${NC}"
            else
                echo "${GREEN}✓ SAFE${NC}"
            fi
            ;;
        *) echo "${GREEN}✓ SAFE${NC}" ;;
    esac
}

# Calculate token savings percentage
calc_token_savings() {
    local sent="$1"
    local available="$2"
    if [ "$available" -gt 0 ] 2>/dev/null; then
        local saved=$((available - sent))
        local percent=$((saved * 100 / available))
        echo "$percent"
    else
        echo "0"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# STATUS COMMAND - Beautiful dashboard
# ═══════════════════════════════════════════════════════════════════════════

show_status() {
    check_docker
    cd "$REPO_DIR"
    
    # Get service status
    local mcp_status="down"
    local dashboard_status="down"
    local security_status="down"
    
    if docker compose ps 2>/dev/null | grep -q "mcp.*Up"; then
        mcp_status="up"
    fi
    if docker compose ps 2>/dev/null | grep -q "dashboard.*Up"; then
        dashboard_status="up"
    fi
    if docker compose ps 2>/dev/null | grep -q "edison.*Up"; then
        security_status="up"
    fi
    
    # Parse logs for metrics
    local total_calls=0
    local avg_latency=0
    local total_latency=0
    local min_latency=999999
    local max_latency=0
    local tokens_saved=0
    local blocked_count=0
    local monitored_count=0
    local servers_seen=""
    
    if [ -f "$LOG_FILE" ]; then
        while IFS= read -r line; do
            # Extract duration
            local duration=$(echo "$line" | grep -o '"duration":[0-9]*' | cut -d':' -f2)
            if [ -n "$duration" ] && [ "$duration" -gt 0 ] 2>/dev/null; then
                total_calls=$((total_calls + 1))
                total_latency=$((total_latency + duration))
                [ "$duration" -lt "$min_latency" ] && min_latency=$duration
                [ "$duration" -gt "$max_latency" ] && max_latency=$duration
            fi
            
            # Extract token savings
            local saved=$(echo "$line" | grep -o '"tokensSaved":[0-9]*' | cut -d':' -f2)
            if [ -n "$saved" ] 2>/dev/null; then
                tokens_saved=$((tokens_saved + saved))
            fi
            
            # Extract security status
            local sec_status=$(echo "$line" | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)
            [ "$sec_status" = "blocked" ] && blocked_count=$((blocked_count + 1))
            [ "$sec_status" = "monitored" ] && monitored_count=$((monitored_count + 1))
            
            # Track servers
            local server=$(echo "$line" | grep -o '"serverName":"[^"]*"' | cut -d'"' -f4)
            if [ -n "$server" ] && [[ ! "$servers_seen" =~ "$server" ]]; then
                servers_seen="$servers_seen $server"
            fi
        done < <(tail -100 "$LOG_FILE" 2>/dev/null)
    fi
    
    # Calculate averages
    if [ "$total_calls" -gt 0 ]; then
        avg_latency=$((total_latency / total_calls))
    fi
    [ "$min_latency" -eq 999999 ] && min_latency=0
    
    # Count unique servers
    local server_count=$(echo "$servers_seen" | wc -w | tr -d ' ')
    local servers_list=$(echo "$servers_seen" | xargs | sed 's/ /, /g')
    [ -z "$servers_list" ] && servers_list="None connected"
    
    # Format token savings
    local tokens_display="0"
    if [ "$tokens_saved" -gt 1000 ]; then
        tokens_display="$((tokens_saved / 1000))k"
    else
        tokens_display="$tokens_saved"
    fi
    
    # Calculate overall token reduction percentage
    local reduction_pct="~90"
    if [ "$total_calls" -gt 0 ]; then
        # Rough estimate based on typical tool counts
        reduction_pct="$((100 - (1 * 100 / 50)))"
    fi
    
    # Print beautiful status
    echo ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}███╗   ██╗███████╗██╗  ██╗██╗   ██╗███████╗${NC}                               ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}████╗  ██║██╔════╝╚██╗██╔╝██║   ██║██╔════╝${NC}                               ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}██╔██╗ ██║█████╗   ╚███╔╝ ██║   ██║███████╗${NC}                               ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}██║╚██╗██║██╔══╝   ██╔██╗ ██║   ██║╚════██║${NC}                               ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}██║ ╚████║███████╗██╔╝ ██╗╚██████╔╝███████║${NC}  ${DIM}v0.1.0${NC}                       ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝${NC}                               ${CYAN}║${NC}"
    echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════════════════╣${NC}"
    
    # Services status
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}SERVICES${NC}                                                                  ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                                           ${CYAN}║${NC}"
    if [ "$mcp_status" = "up" ]; then
        echo -e "${CYAN}║${NC}    ${GREEN}●${NC} MCP Proxy      ${GREEN}Running${NC}     ${DIM}http://localhost:3001/mcp${NC}               ${CYAN}║${NC}"
    else
        echo -e "${CYAN}║${NC}    ${RED}●${NC} MCP Proxy      ${RED}Stopped${NC}                                             ${CYAN}║${NC}"
    fi
    if [ "$dashboard_status" = "up" ]; then
        echo -e "${CYAN}║${NC}    ${GREEN}●${NC} Dashboard      ${GREEN}Running${NC}     ${DIM}http://localhost:3000${NC}                   ${CYAN}║${NC}"
    else
        echo -e "${CYAN}║${NC}    ${RED}●${NC} Dashboard      ${RED}Stopped${NC}                                             ${CYAN}║${NC}"
    fi
    if [ "$security_status" = "up" ]; then
        echo -e "${CYAN}║${NC}    ${GREEN}●${NC} Security       ${GREEN}Active${NC}      ${DIM}Prompt injection protection${NC}            ${CYAN}║${NC}"
    else
        echo -e "${CYAN}║${NC}    ${YELLOW}●${NC} Security       ${YELLOW}Disabled${NC}    ${DIM}Set EDISON_ENABLED=true to enable${NC}      ${CYAN}║${NC}"
    fi
    
    echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════════════════╣${NC}"
    
    # Metrics
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}METRICS${NC} ${DIM}(last 100 calls)${NC}                                                ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                                           ${CYAN}║${NC}"
    
    printf "${CYAN}║${NC}    ⚡ ${WHITE}Latency${NC}        ${GREEN}%3dms${NC} avg  │  ${DIM}%dms min  │  %dms max${NC}                  ${CYAN}║${NC}\n" "$avg_latency" "$min_latency" "$max_latency"
    printf "${CYAN}║${NC}    💰 ${WHITE}Tokens Saved${NC}   ${GREEN}~%s${NC} tokens  ${DIM}(~%d%% reduction per call)${NC}              ${CYAN}║${NC}\n" "$tokens_display" "$reduction_pct"
    
    if [ "$blocked_count" -gt 0 ]; then
        printf "${CYAN}║${NC}    🛡️  ${WHITE}Security${NC}       ${RED}%d blocked${NC}  │  ${YELLOW}%d monitored${NC}                         ${CYAN}║${NC}\n" "$blocked_count" "$monitored_count"
    else
        printf "${CYAN}║${NC}    🛡️  ${WHITE}Security${NC}       ${GREEN}0 threats${NC}  │  ${YELLOW}%d monitored${NC}                         ${CYAN}║${NC}\n" "$monitored_count"
    fi
    
    echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════════════════╣${NC}"
    
    # Connected servers
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}MCP SERVERS${NC} ${DIM}($server_count active)${NC}                                            ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                                           ${CYAN}║${NC}"
    
    # Show servers nicely
    if [ -n "$servers_seen" ] && [ "$servers_seen" != " " ]; then
        local server_icons=""
        for s in $servers_seen; do
            case "$s" in
                GitHub) server_icons="$server_icons  ${WHITE}◆${NC} GitHub" ;;
                Linear) server_icons="$server_icons  ${MAGENTA}◆${NC} Linear" ;;
                Supabase) server_icons="$server_icons  ${GREEN}◆${NC} Supabase" ;;
                Firecrawl) server_icons="$server_icons  ${YELLOW}◆${NC} Firecrawl" ;;
                Notion) server_icons="$server_icons  ${WHITE}◆${NC} Notion" ;;
                n8n) server_icons="$server_icons  ${CYAN}◆${NC} n8n" ;;
                *) server_icons="$server_icons  ${CYAN}◆${NC} $s" ;;
            esac
        done
        echo -e "${CYAN}║${NC}   $server_icons                                                     ${CYAN}║${NC}"
    else
        echo -e "${CYAN}║${NC}    ${DIM}No servers have been called yet. Try using Cursor with MCP!${NC}            ${CYAN}║${NC}"
    fi
    
    echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  ${DIM}Commands:  nexus logs    nexus logs -f    nexus metrics    nexus help${NC}    ${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
# LOGS COMMAND - Enhanced with metrics
# ═══════════════════════════════════════════════════════════════════════════

# Pretty print a log entry with full metrics
pretty_print_log() {
    local json="$1"
    
    # Parse JSON fields
    local timestamp=$(echo "$json" | grep -o '"timestamp":"[^"]*"' | cut -d'"' -f4)
    local server=$(echo "$json" | grep -o '"serverName":"[^"]*"' | cut -d'"' -f4)
    local action=$(echo "$json" | grep -o '"action":"[^"]*"' | cut -d'"' -f4)
    local tool=$(echo "$json" | grep -o '"toolName":"[^"]*"' | cut -d'"' -f4)
    local error=$(echo "$json" | grep -o '"error":"[^"]*"' | cut -d'"' -f4)
    local summary=$(echo "$json" | grep -o '"summary":"[^"]*"' | cut -d'"' -f4)
    local duration=$(echo "$json" | grep -o '"duration":[0-9]*' | cut -d':' -f2)
    
    # Parse routing info
    local tools_sent=$(echo "$json" | grep -o '"toolsSent":[0-9]*' | cut -d':' -f2)
    local tools_available=$(echo "$json" | grep -o '"toolsAvailable":[0-9]*' | cut -d':' -f2)
    local tokens_saved=$(echo "$json" | grep -o '"tokensSaved":[0-9]*' | cut -d':' -f2)
    
    # Parse security info
    local sec_status=$(echo "$json" | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)
    local trust_level=$(echo "$json" | grep -o '"trustLevel":"[^"]*"' | cut -d'"' -f4)
    
    # Format time
    local time=$(format_timestamp "$timestamp")
    
    # Get emoji
    local emoji=$(get_action_emoji "$action")
    
    # Calculate token savings percentage
    local savings_pct=0
    if [ -n "$tools_available" ] && [ "$tools_available" -gt 0 ] 2>/dev/null; then
        savings_pct=$(calc_token_savings "$tools_sent" "$tools_available")
    fi
    
    # Build metrics line
    local metrics_line=""
    if [ -n "$duration" ] && [ "$duration" -gt 0 ] 2>/dev/null; then
        metrics_line="${CYAN}⚡${NC} ${duration}ms"
    fi
    if [ -n "$savings_pct" ] && [ "$savings_pct" -gt 0 ] 2>/dev/null; then
        metrics_line="$metrics_line  ${GREEN}💰${NC} ${savings_pct}% saved"
    fi
    
    # Get security badge
    local security_badge=$(get_security_badge "$sec_status" "$trust_level")
    if [ -n "$security_badge" ]; then
        metrics_line="$metrics_line  $security_badge"
    fi
    
    # Print header line
    echo -e "${GRAY}[$time]${NC} $metrics_line"
    echo -e "   $emoji ${BLUE}${server}${NC} → ${WHITE}${tool}${NC}"
    
    # Extract and print parameters
    local params=$(echo "$json" | sed -n 's/.*"parameters":\({[^}]*}\).*/\1/p')
    if [ -n "$params" ]; then
        local query=$(echo "$params" | grep -o '"query":"[^"]*"' | cut -d'"' -f4)
        local q=$(echo "$params" | grep -o '"q":"[^"]*"' | cut -d'"' -f4)
        local repo=$(echo "$params" | grep -o '"repo":"[^"]*"' | cut -d'"' -f4)
        local owner=$(echo "$params" | grep -o '"owner":"[^"]*"' | cut -d'"' -f4)
        
        local param_str=""
        [ -n "$query" ] && param_str="query: \"$query\""
        [ -n "$q" ] && param_str="$q"
        [ -n "$repo" ] && param_str="$param_str repo: $repo"
        [ -n "$owner" ] && param_str="$param_str owner: $owner"
        
        if [ -n "$param_str" ]; then
            echo -e "   ${GRAY}├─${NC} ${DIM}$param_str${NC}"
        fi
    fi
    
    # Print result
    if [ -n "$error" ]; then
        echo -e "   ${RED}└─ ✗ $error${NC}"
    elif [ -n "$summary" ]; then
        echo -e "   ${GREEN}└─ ✓ $summary${NC}"
    fi
    
    echo ""
}

show_logs() {
    local follow=false
    local clear_logs=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=true ;;
            --clear) clear_logs=true ;;
        esac
        shift
    done
    
    if [ "$clear_logs" = true ]; then
        if [ -f "$LOG_FILE" ]; then
            rm "$LOG_FILE"
            echo -e "${GREEN}✓${NC} Activity logs cleared"
        else
            echo -e "${YELLOW}⚠${NC} No logs to clear"
        fi
        return
    fi
    
    if [ ! -f "$LOG_FILE" ]; then
        echo ""
        echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}NEXUS ACTIVITY LOGS${NC}                                       ${CYAN}║${NC}"
        echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}                                                               ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}  ${YELLOW}No activity yet.${NC} Start using Nexus with Cursor!            ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}                                                               ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}  ${DIM}What gets logged:${NC}                                           ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}    • GitHub: repos, issues, PRs accessed                      ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}    • Linear: issues, projects queried                         ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}    • Any MCP tool calls + latency + security status           ${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}                                                               ${CYAN}║${NC}"
        echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        return
    fi
    
    if [ "$follow" = true ]; then
        echo ""
        echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}NEXUS ACTIVITY${NC} ${DIM}(live)${NC}                ${YELLOW}Press Ctrl+C to exit${NC}    ${CYAN}║${NC}"
        echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        
        # Show last 5 entries first
        tail -n 5 "$LOG_FILE" 2>/dev/null | while IFS= read -r line; do
            pretty_print_log "$line"
        done
        
        echo -e "${GRAY}─────────────────────────────────────────────────────────────────${NC}"
        echo -e "${DIM}Waiting for new activity...${NC}"
        echo ""
        
        # Follow new lines
        tail -f "$LOG_FILE" 2>/dev/null | while IFS= read -r line; do
            pretty_print_log "$line"
        done
    else
        echo ""
        echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}NEXUS ACTIVITY${NC} ${DIM}(recent)${NC}                                     ${CYAN}║${NC}"
        echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        
        # Show last 15 entries
        tail -n 15 "$LOG_FILE" 2>/dev/null | while IFS= read -r line; do
            pretty_print_log "$line"
        done
        
        echo -e "${GRAY}─────────────────────────────────────────────────────────────────${NC}"
        echo -e "${DIM}Tip: Use 'nexus logs -f' to watch activity in real-time${NC}"
        echo ""
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# METRICS COMMAND - Quick summary
# ═══════════════════════════════════════════════════════════════════════════

show_metrics() {
    echo ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${WHITE}${BOLD}NEXUS METRICS SUMMARY${NC}                                       ${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    if [ ! -f "$LOG_FILE" ]; then
        echo -e "  ${YELLOW}No data yet.${NC} Start using Nexus to collect metrics!"
        echo ""
        return
    fi
    
    # Calculate metrics from log file
    local total_calls=0
    local total_latency=0
    local total_tokens_saved=0
    local blocked=0
    local monitored=0
    local errors=0
    
    while IFS= read -r line; do
        total_calls=$((total_calls + 1))
        
        local duration=$(echo "$line" | grep -o '"duration":[0-9]*' | cut -d':' -f2)
        [ -n "$duration" ] && total_latency=$((total_latency + duration))
        
        local saved=$(echo "$line" | grep -o '"tokensSaved":[0-9]*' | cut -d':' -f2)
        [ -n "$saved" ] && total_tokens_saved=$((total_tokens_saved + saved))
        
        local status=$(echo "$line" | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)
        [ "$status" = "blocked" ] && blocked=$((blocked + 1))
        [ "$status" = "monitored" ] && monitored=$((monitored + 1))
        
        echo "$line" | grep -q '"error":' && errors=$((errors + 1))
    done < "$LOG_FILE"
    
    local avg_latency=0
    [ "$total_calls" -gt 0 ] && avg_latency=$((total_latency / total_calls))
    
    local success_rate=100
    [ "$total_calls" -gt 0 ] && success_rate=$(( (total_calls - errors) * 100 / total_calls ))
    
    # Format tokens
    local tokens_display="$total_tokens_saved"
    if [ "$total_tokens_saved" -gt 1000000 ]; then
        tokens_display="$((total_tokens_saved / 1000000))M"
    elif [ "$total_tokens_saved" -gt 1000 ]; then
        tokens_display="$((total_tokens_saved / 1000))k"
    fi
    
    echo -e "  ${WHITE}${BOLD}Performance${NC}"
    echo -e "  ─────────────────────────────────────────"
    printf "  %-20s ${GREEN}%s${NC}\n" "Total Calls:" "$total_calls"
    printf "  %-20s ${GREEN}%dms${NC}\n" "Avg Latency:" "$avg_latency"
    printf "  %-20s ${GREEN}%d%%${NC}\n" "Success Rate:" "$success_rate"
    echo ""
    
    echo -e "  ${WHITE}${BOLD}Token Efficiency${NC}"
    echo -e "  ─────────────────────────────────────────"
    printf "  %-20s ${GREEN}~%s${NC}\n" "Tokens Saved:" "$tokens_display"
    printf "  %-20s ${GREEN}~%d%%${NC} ${DIM}(1 tool sent vs ~50 available)${NC}\n" "Reduction:" "98"
    echo ""
    
    echo -e "  ${WHITE}${BOLD}Security${NC}"
    echo -e "  ─────────────────────────────────────────"
    printf "  %-20s ${RED}%d${NC}\n" "Threats Blocked:" "$blocked"
    printf "  %-20s ${YELLOW}%d${NC}\n" "Calls Monitored:" "$monitored"
    echo ""
    
    # Cost savings estimate
    local cost_saved=0
    if [ "$total_tokens_saved" -gt 0 ]; then
        # $3 per 1M tokens (Claude Haiku input pricing)
        cost_saved=$(echo "scale=2; $total_tokens_saved * 3 / 1000000" | bc 2>/dev/null || echo "0.00")
    fi
    
    echo -e "  ${WHITE}${BOLD}Cost Impact${NC} ${DIM}(Claude Haiku pricing)${NC}"
    echo -e "  ─────────────────────────────────────────"
    printf "  %-20s ${GREEN}\$%s${NC}\n" "Estimated Savings:" "$cost_saved"
    echo ""
}

