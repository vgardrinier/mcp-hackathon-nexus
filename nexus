#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Detect repo directory
REPO_DIR=""
if [ -d "$HOME/.nexus/repo" ]; then
    REPO_DIR="$HOME/.nexus/repo"
else
    echo -e "${RED}✗${NC} Nexus not found. Please run the install script first."
    exit 1
fi

LOG_FILE="$HOME/.config/nexus/logs/activity.jsonl"

# Show help
show_help() {
    echo -e "${BLUE}Nexus CLI${NC} - Manage your local MCP server setup"
    echo ""
    echo "Usage: nexus <command>"
    echo ""
    echo "Commands:"
    echo "  ${GREEN}logs${NC}         Show activity logs (what data was read/written)"
    echo "  ${GREEN}logs -f${NC}      Follow logs in real-time"
    echo "  ${GREEN}logs --clear${NC} Clear all activity logs"
    echo "  ${GREEN}status${NC}       Show status of Nexus services"
    echo "  ${GREEN}restart${NC}      Restart all services"
    echo "  ${GREEN}stop${NC}         Stop all services"
    echo "  ${GREEN}start${NC}        Start all services"
    echo "  ${GREEN}update${NC}       Pull latest changes and restart"
    echo "  ${GREEN}config${NC}       Open config directory"
    echo "  ${GREEN}dashboard${NC}    Open dashboard in browser"
    echo "  ${GREEN}uninstall${NC}    Completely remove Nexus"
    echo "  ${GREEN}help${NC}         Show this help message"
    echo ""
    echo "Examples:"
    echo "  nexus logs           # View recent activity"
    echo "  nexus logs -f        # Watch activity in real-time"
    echo "  nexus status         # Check service status"
    echo ""
}

# Check if Docker is running
check_docker() {
    if ! docker ps &> /dev/null 2>&1; then
        echo -e "${RED}✗${NC} Docker is not running. Please start Docker Desktop."
        exit 1
    fi
}

# Format timestamp to be more readable
format_timestamp() {
    local ts="$1"
    if date -j &>/dev/null 2>&1; then
        # macOS
        date -j -f "%Y-%m-%dT%H:%M:%S" "${ts:0:19}" "+%H:%M:%S" 2>/dev/null || echo "${ts:11:8}"
    else
        # Linux
        date -d "$ts" "+%H:%M:%S" 2>/dev/null || echo "${ts:11:8}"
    fi
}

# Get emoji for action
get_action_emoji() {
    case "$1" in
        search|find|query) echo "🔍" ;;
        list|get|read|fetch) echo "📖" ;;
        create|add) echo "✍️ " ;;
        update|edit|modify) echo "✏️ " ;;
        delete|remove) echo "🗑️ " ;;
        *) echo "🔧" ;;
    esac
}

# Pretty print a log entry
pretty_print_log() {
    local json="$1"

    # Parse JSON fields
    local timestamp=$(echo "$json" | grep -o '"timestamp":"[^"]*"' | cut -d'"' -f4)
    local server=$(echo "$json" | grep -o '"serverName":"[^"]*"' | cut -d'"' -f4)
    local action=$(echo "$json" | grep -o '"action":"[^"]*"' | cut -d'"' -f4)
    local tool=$(echo "$json" | grep -o '"toolName":"[^"]*"' | cut -d'"' -f4)
    local error=$(echo "$json" | grep -o '"error":"[^"]*"' | cut -d'"' -f4)
    local success=$(echo "$json" | grep -o '"success":[^,}]*' | cut -d':' -f2)
    local summary=$(echo "$json" | grep -o '"summary":"[^"]*"' | cut -d'"' -f4)
    local duration=$(echo "$json" | grep -o '"duration":[^,}]*' | cut -d':' -f2)

    # Format time
    local time=$(format_timestamp "$timestamp")

    # Get emoji
    local emoji=$(get_action_emoji "$action")

    # Extract parameters (basic)
    local params=$(echo "$json" | sed -n 's/.*"parameters":\({[^}]*}\).*/\1/p')
    local param_str=""
    if [ -n "$params" ]; then
        # Try to extract query or other key params
        local query=$(echo "$params" | grep -o '"query":"[^"]*"' | cut -d'"' -f4)
        local q=$(echo "$params" | grep -o '"q":"[^"]*"' | cut -d'"' -f4)
        local repo=$(echo "$params" | grep -o '"repo":"[^"]*"' | cut -d'"' -f4)
        local owner=$(echo "$params" | grep -o '"owner":"[^"]*"' | cut -d'"' -f4)

        [ -n "$query" ] && param_str="${param_str}query: $query"
        [ -n "$q" ] && param_str="${param_str}$q"
        [ -n "$repo" ] && param_str="${param_str} repo: $repo"
        [ -n "$owner" ] && param_str="${param_str} owner: $owner"
    fi

    # Print formatted log
    echo -e "${CYAN}[$time]${NC} ${emoji} ${BLUE}${server}${NC}: ${action} ${tool##*_}"

    if [ -n "$param_str" ]; then
        echo -e "   ${YELLOW}├─${NC} ${param_str}"
    fi

    if [ -n "$error" ]; then
        echo -e "   ${RED}└─ ✗ Error: ${error}${NC}"
    elif [ -n "$summary" ]; then
        echo -e "   ${GREEN}└─ ✓ ${summary}${NC}"
        if [ -n "$duration" ]; then
            echo -e "      ${MAGENTA}(${duration}ms)${NC}"
        fi
    fi

    echo ""
}

# Show activity logs
show_logs() {
    local follow=false
    local clear_logs=false

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=true ;;
            --clear) clear_logs=true ;;
        esac
        shift
    done

    if [ "$clear_logs" = true ]; then
        if [ -f "$LOG_FILE" ]; then
            rm "$LOG_FILE"
            echo -e "${GREEN}✓${NC} Activity logs cleared"
        else
            echo -e "${YELLOW}⚠${NC} No logs to clear"
        fi
        return
    fi

    if [ ! -f "$LOG_FILE" ]; then
        echo -e "${YELLOW}⚠${NC} No activity logs yet. Start using Nexus to see logs here."
        echo ""
        echo "Activity logs show what data Nexus reads/writes from your apps:"
        echo "  • GitHub: repos, issues, PRs accessed"
        echo "  • Linear: issues, projects queried"
        echo "  • Supabase: projects, databases accessed"
        echo ""
        return
    fi

    if [ "$follow" = true ]; then
        echo -e "${BLUE}Watching Nexus activity...${NC}"
        echo -e "${YELLOW}Press Ctrl+C to exit${NC}"
        echo ""

        # Show last 10 lines first
        tail -n 10 "$LOG_FILE" | while IFS= read -r line; do
            pretty_print_log "$line"
        done

        # Follow new lines
        tail -f "$LOG_FILE" | while IFS= read -r line; do
            pretty_print_log "$line"
        done
    else
        echo -e "${BLUE}Recent Nexus activity:${NC}"
        echo ""

        # Show last 20 lines
        tail -n 20 "$LOG_FILE" | while IFS= read -r line; do
            pretty_print_log "$line"
        done

        echo -e "${CYAN}Tip:${NC} Use 'nexus logs -f' to watch activity in real-time"
    fi
}

# Main command handler
case "$1" in
    logs)
        shift
        show_logs "$@"
        ;;

    status)
        check_docker
        cd "$REPO_DIR"
        echo -e "${BLUE}Nexus Service Status:${NC}"
        echo ""
        docker compose ps
        echo ""
        if docker compose ps | grep -q "Up"; then
            echo -e "${GREEN}✓${NC} Dashboard: http://localhost:3000"
            echo -e "${GREEN}✓${NC} MCP Endpoint: http://localhost:3001/mcp"
        else
            echo -e "${RED}✗${NC} Services are not running. Run 'nexus start' to start them."
        fi
        ;;

    restart)
        check_docker
        cd "$REPO_DIR"
        echo -e "${BLUE}Restarting Nexus services...${NC}"
        docker compose restart
        echo -e "${GREEN}✓${NC} Services restarted"
        ;;

    stop)
        check_docker
        cd "$REPO_DIR"
        echo -e "${BLUE}Stopping Nexus services...${NC}"
        docker compose down
        echo -e "${GREEN}✓${NC} Services stopped"
        ;;

    start)
        check_docker
        cd "$REPO_DIR"
        echo -e "${BLUE}Starting Nexus services...${NC}"
        docker compose up -d
        sleep 3
        if docker compose ps | grep -q "Up"; then
            echo -e "${GREEN}✓${NC} Services started successfully"
            echo ""
            echo -e "${GREEN}✓${NC} Dashboard: http://localhost:3000"
            echo -e "${GREEN}✓${NC} MCP Endpoint: http://localhost:3001/mcp"
        else
            echo -e "${RED}✗${NC} Failed to start services. Check logs with 'nexus logs'"
        fi
        ;;

    update)
        check_docker
        cd "$REPO_DIR"
        echo -e "${BLUE}Updating Nexus...${NC}"

        # Stop services
        docker compose down

        # Pull latest
        echo -e "${BLUE}Pulling latest changes...${NC}"
        git pull origin master

        # Restart
        echo -e "${BLUE}Restarting services...${NC}"
        docker compose up -d

        sleep 3
        echo -e "${GREEN}✓${NC} Nexus updated and restarted"
        ;;

    config)
        CONFIG_DIR="$HOME/.config/nexus"
        if [ -d "$CONFIG_DIR" ]; then
            echo -e "${BLUE}Opening config directory:${NC} $CONFIG_DIR"

            # Try to open with default file manager
            if command -v open &> /dev/null; then
                open "$CONFIG_DIR"  # macOS
            elif command -v xdg-open &> /dev/null; then
                xdg-open "$CONFIG_DIR"  # Linux
            else
                echo "$CONFIG_DIR"
            fi
        else
            echo -e "${RED}✗${NC} Config directory not found: $CONFIG_DIR"
        fi
        ;;

    dashboard)
        echo -e "${BLUE}Opening dashboard...${NC}"
        DASHBOARD_URL="http://localhost:3000"

        # Check if service is running
        if docker compose ps 2>/dev/null | grep -q "dashboard.*Up"; then
            # Try to open with default browser
            if command -v open &> /dev/null; then
                open "$DASHBOARD_URL"  # macOS
            elif command -v xdg-open &> /dev/null; then
                xdg-open "$DASHBOARD_URL"  # Linux
            else
                echo "$DASHBOARD_URL"
            fi
        else
            echo -e "${YELLOW}⚠${NC} Dashboard is not running. Start it with 'nexus start'"
        fi
        ;;

    uninstall)
        echo -e "${YELLOW}⚠  This will completely remove Nexus from your system:${NC}"
        echo "  - Stop and remove Docker containers"
        echo "  - Delete ~/.nexus (repo and data)"
        echo "  - Delete ~/.config/nexus (configuration and logs)"
        echo "  - Remove nexus CLI from /usr/local/bin or ~/.local/bin"
        echo ""
        read -p "Are you sure? (y/N) " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo -e "${BLUE}Uninstall cancelled${NC}"
            exit 0
        fi

        echo ""
        echo -e "${BLUE}Uninstalling Nexus...${NC}"

        # Stop and remove containers
        if [ -d "$REPO_DIR" ]; then
            cd "$REPO_DIR"
            if command -v docker &> /dev/null && docker ps &> /dev/null 2>&1; then
                echo -e "${BLUE}Stopping Docker containers...${NC}"
                docker compose down -v 2>/dev/null || true
            fi
        fi

        # Remove directories
        echo -e "${BLUE}Removing Nexus files...${NC}"
        [ -d "$HOME/.nexus" ] && rm -rf "$HOME/.nexus" && echo -e "${GREEN}✓${NC} Removed ~/.nexus"
        [ -d "$HOME/.config/nexus" ] && rm -rf "$HOME/.config/nexus" && echo -e "${GREEN}✓${NC} Removed ~/.config/nexus"

        # Remove CLI symlinks
        if [ -L "/usr/local/bin/nexus" ]; then
            if [ -w "/usr/local/bin" ]; then
                rm /usr/local/bin/nexus && echo -e "${GREEN}✓${NC} Removed /usr/local/bin/nexus"
            else
                sudo rm /usr/local/bin/nexus 2>/dev/null && echo -e "${GREEN}✓${NC} Removed /usr/local/bin/nexus" || \
                    echo -e "${YELLOW}⚠${NC} Could not remove /usr/local/bin/nexus (run: sudo rm /usr/local/bin/nexus)"
            fi
        fi

        if [ -L "$HOME/.local/bin/nexus" ]; then
            rm "$HOME/.local/bin/nexus" && echo -e "${GREEN}✓${NC} Removed ~/.local/bin/nexus"
        fi

        echo ""
        echo -e "${GREEN}✓${NC} Nexus uninstalled successfully"
        echo ""
        echo -e "${BLUE}Don't forget to:${NC}"
        echo "  - Remove Nexus config from Cursor Settings → Features → Model Context Protocol"
        echo "  - Restart Cursor"
        ;;

    help|--help|-h|"")
        show_help
        ;;

    *)
        echo -e "${RED}✗${NC} Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
